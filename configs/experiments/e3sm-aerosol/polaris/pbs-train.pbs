#!/bin/bash -l
#PBS -N fme-train
#PBS -A E3SMinput
#PBS -l select=NUMNODES:system=polaris
#PBS -l place=scatter
#PBS -l walltime=WALLTIME
#PBS -l filesystems=home:eagle
#PBS -q QUEUE
#PBS -j oe
#PBS -M @PBS_MAIL@
#PBS -m @PBS_MAIL_EVENTS@

#PBS -o @PBS_LOG_FILE@
#PBS -e @PBS_LOG_FILE@

set -euo pipefail

CONFIG_DIR="@CONFIG_DIR@"
# shellcheck source=/dev/null
source "${CONFIG_DIR}/job.env"
# shellcheck source=env.sh
source "${CONFIG_DIR}/env.sh"

export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export PYTHONPATH="${ACE_ROOT}:${PYTHONPATH:-}"

if [[ -z "${RESUME_JOB_ID:-}" ]]; then
    export FME_OUTPUT_DIR="${FME_OUTPUT_ROOT}/${PBS_JOBID}"
else
    export FME_OUTPUT_DIR="${FME_OUTPUT_ROOT}/${RESUME_JOB_ID}"
fi
mkdir -p "$FME_OUTPUT_DIR"

# PBS -o already captures stdout/stderr to PBS_LOG_FILE (under PBS_LOG_ROOT).
# Ensure pbs-<short-jobid>.out exists when submit-time symlink is missing.
PBS_LOG_ROOT="${PBS_LOG_ROOT:-$(dirname "${PBS_LOG_FILE:-/tmp}")}"
mkdir -p "$PBS_LOG_ROOT"
SHORT_ID="${PBS_JOBID%%.*}"
JOB_LOG="${PBS_LOG_ROOT}/pbs-${SHORT_ID}.out"
if [[ -n "${PBS_LOG_FILE:-}" && "$JOB_LOG" != "$PBS_LOG_FILE" && ! -e "$JOB_LOG" ]]; then
    ln -sfn "$(basename "$PBS_LOG_FILE")" "$JOB_LOG" 2>/dev/null || true
fi

echo "=== Polaris train job ${PBS_JOBID} on $(hostname) $(date) ==="
echo "MODE=$MODE CONFIG_DIR=$CONFIG_DIR"
echo "ACE_ROOT=$ACE_ROOT FME_VENV=$FME_VENV"

# Conda first for python/torch; train.sh uses absolute PALS mpiexec so Hydra
# mpiexec in this env does not shadow the multi-node launcher.
export PATH="${FME_VENV}/bin:$PATH"
nvidia-smi -L || true

bash "${CONFIG_DIR}/train.sh"

echo "=== finished $(date) ==="
